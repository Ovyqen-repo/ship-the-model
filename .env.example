# Server only. Do not prefix secrets with NEXT_PUBLIC_.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional kill switch. Set to "1" to refuse generation.
DISABLE_GENERATION=0

# Chapter 2 on-ramp only. Production and capstone: leave at 0.
ALLOW_ANON=0

# Clerk — from the Clerk dashboard. NEXT_PUBLIC_ publishable key is public by design.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# SQLite file. Default is fine for local.
DATABASE_PATH=./data/astra.db
